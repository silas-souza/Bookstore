# Python files MUST use LF (Linux line endings)
*.py text eol=lf
*.pyi text eol=lf
*.pyx text eol=lf

# Python diff
*.py diff=python

# Auto detect
* text=auto

# Other text files
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Windows specific
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pyc binary
*.pyo binary
*.pyd binary
*.so binary
*.dll binary
*.exe binary
*.db binary
*.sqlite binary
*.zip binary
*.gz binary
*.tar binary
